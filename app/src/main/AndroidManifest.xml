<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- Explore browses the Connections Wallpaper gallery and downloads originals; sign-in talks to Connections. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Connections Analytics records whether the phone is on Wi-Fi or cellular (AnalyticsDevice); without
         this permission that read throws and every analytics event fails. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live mode asks whether this device has a screen that turns on a live wallpaper (canPickLiveWallpaper). -->
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.CHANGE_LIVE_WALLPAPER" />
        </intent>
        <intent>
            <action android:name="android.service.wallpaper.LIVE_WALLPAPER_CHOOSER" />
        </intent>
    </queries>
    <!-- Features -->
    <uses-feature
        android:name="android.software.wallpaper"
        android:required="false" />

    <application
        android:name=".PaperizeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Paperize">

        <!-- Disable default WorkManager initialization (using custom Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Connections originals the app keeps for albums and the wallpaper (files/connections), read back as content:// like any picture -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.connections"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/connections_files" />
        </provider>

        <!-- Main Activity -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:configChanges="uiMode|density|orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".service.shortcut.WallpaperShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Connections sign-in: the browser returns here with the code, then the app comes back -->
        <activity
            android:name=".connections.SignInReturnActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="aegis-handoff"
                    android:scheme="icu.connections.wallpaper" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.wallpaper.WallpaperChangeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.unlock.UnlockChangeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Sets the next wallpaper as the screen turns off, so a new one shows at unlock" />
        </service>

        <!-- Broadcast Receivers -->
        <receiver
            android:name=".service.alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: next wallpaper -->
        <receiver
            android:name=".service.widget.NextWallpaperWidget"
            android:exported="false"
            android:label="@string/widget_next_wallpaper">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_wallpaper_info" />
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.tile.WallpaperTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Live Wallpaper Service -->
        <service
            android:name=".service.livewallpaper.PaperizeLiveWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>
